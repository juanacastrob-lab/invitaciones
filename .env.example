# Copia estos nombres en Netlify (Site configuration > Environment variables).
# Los valores salen de Supabase: Project Settings > API.

# URL publica del sitio (la que te da Netlify, o tu dominio propio)
NEXT_PUBLIC_SITE_URL=https://tu-sitio.netlify.app

# Nombre comercial. Se cambia aqui, nunca en el codigo.
NEXT_PUBLIC_APP_NAME=Hola Boda

# Supabase - llaves publicas (viajan al navegador, no son secretas)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - llave privada. SOLO servidor. Nunca en git, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Botones de login que se muestran, separados por coma: google,apple
# Solo pon uno cuando ya lo hayas configurado en Supabase > Authentication > Providers.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Aviso de privacidad: responsable y correo de contacto (opcional, tienen valor por defecto)
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp de ventas en formato E.164 (opcional, tiene valor por defecto)
NEXT_PUBLIC_WHATSAPP_NUMBER=+525662974440

# Datos bancarios para pagos por transferencia (opcionales, tienen valor por defecto)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_HOLDER=
NEXT_PUBLIC_BANK_CLABE=

# Correo a invitados (opcional). Sin esto, el botón de correo queda apagado.
# La llave se crea en resend.com; EMAIL_FROM debe ser de un dominio verificado ahí.
RESEND_API_KEY=
EMAIL_FROM="Hola Boda <hola@holaboda.mx>"

# Recordatorios automáticos: cualquier texto largo y aleatorio. La función programada
# de Netlify lo usa para llamar a /api/cron/reminders. Sin esto no corren.
CRON_SECRET=

# WhatsApp Cloud API (Meta), opcional. Con esto los recordatorios automáticos salen
# por WhatsApp a quien tenga teléfono. Requiere plantillas aprobadas en Meta con el
# mismo nombre que en message_templates (ver README).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
